---
import Base from '../layouts/Base.astro';
// 거래가 적어 정적 페이지를 만들지 않은 단지(/apt/{id}/)는 여기서 클라이언트가 요약을 그려준다.
---
<Base title="페이지를 찾을 수 없어요" noindex>
  <div id="nf">
    <section class="card">
      <h1 class="h" style="font-size:20px;margin:0 0 6px">페이지를 찾을 수 없어요</h1>
      <p class="sub2" style="margin:0">주소가 바뀌었거나 아직 만들어지지 않은 페이지입니다.</p>
    </section>
    <a class="btn" href="/" style="margin-top:12px">홈으로</a>
  </div>
</Base>

<script>
  const m = location.pathname.match(/^\/apt\/(\d{5})-(\d+)\/?$/);
  const root = document.getElementById('nf')!;
  if (m) {
    const id = `${m[1]}-${m[2]}`;
    root.innerHTML = '<div class="card"><p class="sub2" style="margin:0">단지 정보를 불러오는 중…</p></div>';
    const eok = (man: number | null) => man == null ? '—' : man < 10000 ? `${Math.round(man).toLocaleString()}만` : `${(man / 10000).toFixed(2).replace(/\.?0+$/, '')}억`;
    const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const basis: Record<string, string> = { median6: '최근 6개월 중앙값', ref: '참고용 · 6개월 3건 미만', last: '마지막 거래가' };
    const report = (name: string, cid: string, asOf: string) => `mailto:xix1223.ad.2025@gmail.com?subject=${encodeURIComponent(`[쏙집 제보] ${name} (${cid})`)}&body=${encodeURIComponent(`페이지: https://korea-rich.com/apt/${cid}/\n데이터 기준일: ${asOf}\n\n이상한 항목 (해당하는 것만 남겨주세요): 세대수 / 준공년도 / 면적·평형 / 시세·실거래 / 위치 / 기타\n\n어떻게 이상한가요?\n`)}`;
    // id 앞자리가 개편 전 시군구 코드면 regions.json의 idPrefix로 실제 코드를 찾는다
    const load = async (): Promise<{ d: any; c: any } | null> => {
      let cands = [m[1]];
      try { const rg = await fetch('/data/regions.json').then((r) => r.json()); cands = [m[1], ...(rg.idPrefix?.[m[1]] ?? [])]; } catch {}
      for (const l of cands) {
        const r = await fetch(`/data/complexes/${l}.json`); if (!r.ok) continue;
        const d = await r.json(); const c = d.c.find((x: any) => x.id === id);
        if (c) return { d, c };
      }
      return null;
    };
    load().then((hit) => {
      if (!hit) { root.querySelector('p')!.textContent = '이 단지 정보를 찾지 못했어요.'; return; }
      const { d, c } = hit;
      document.title = `${c.n} 실거래가·시세 · 쏙집`;
      root.innerHTML = `
        <nav class="sub" style="padding:2px 4px 6px"><a href="/">홈</a> › <a href="/area/${esc(d.lawd)}/">${esc(d.sido)} ${esc(d.sigungu)}</a> › ${esc(c.d)}</nav>
        <header class="q" style="padding:4px 4px 10px">
          <h1 class="big" style="margin:0;font-size:24px">${esc(c.n)}${c.h ? ' <span class="pill p-hot" style="font-size:12px;vertical-align:4px;margin-left:8px">🔥 거래 활발</span>' : ''}</h1>
          <p class="sub2" style="margin:6px 0 0">${esc(d.sido)} ${esc(d.sigungu)} ${esc(c.d)}${c.b ? ` · ${c.b}년 준공` : ''}${c.u ? ` · ${c.u.toLocaleString()}세대` : ''}</p>
        </header>
        <section class="card">
          <span class="pill p-soft">거래가 적은 단지</span>
          <p class="sub2" style="margin:8px 0 0">최근 36개월 실거래가 ${c.n36}건이라 요약만 보여드려요. 거래가 5건 이상 쌓이면 상세 페이지가 만들어집니다.</p>
        </section>
        <section class="card" style="margin-top:12px">
          <h2 style="font-size:16px;margin:0 0 8px">평형별 시세</h2>
          ${c.t.map((t: any) => `<div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--soft)"><span><b>${t[0]}㎡</b> <span class="sub">${t[2] ? basis[t[2]] ?? '' : '거래 없음'}${t[3] ? ` · 6개월 ${t[3]}건` : ''}</span></span><b>${eok(t[1])}</b></div>`).join('')}
          ${c.l ? `<p class="sub" style="margin:10px 0 0">마지막 거래 ${esc(c.l[0])} · ${c.l[2]}㎡ · ${eok(c.l[1])}</p>` : ''}
          <p class="src">출처: 국토교통부 실거래가 (${esc(d.asOf)} 기준). 해제·직거래는 시세 계산에서 제외.</p>
        </section>
        <a class="btn" href="/find/?lawd=${esc(d.lawd)}" style="margin-top:12px">${esc(d.sigungu)} 다른 단지 보기</a>
        <p class="sub2" style="margin:14px 4px 0;font-size:13px"><a href="${report(c.n, id, d.asOf)}" style="color:var(--blue);font-weight:600">이 단지 정보가 틀렸나요? 제보하기 ›</a></p>`;
    }).catch(() => { root.querySelector('p')!.textContent = '단지 정보를 불러오지 못했어요.'; });
  }
</script>
