---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { CATEGORY, isLive, fmtDate } from '../../lib/ui/guide.ts';
const all = (await getCollection('guide')).filter(isLive).sort((a, b) => b.data.publishAt.localeCompare(a.data.publishAt));
const byCat = Object.keys(CATEGORY).map((k) => ({ key: k, ...CATEGORY[k], items: all.filter((e) => e.data.category === k) })).filter((c) => c.items.length);
---
<Base title="공부 가이드" description="집 사기 전에 알아야 할 대출·세금·시세 읽는 법을 숫자와 출처로 정리한 글 모음. 딱집 계산기·집 찾기와 같은 규칙표를 씁니다.">
  <div class="q" style="padding:4px 4px 10px">
    <h1 class="big" style="margin:0;font-size:22px">공부 가이드</h1>
    <p class="sub2" style="margin:4px 0 0">판단 대신 숫자와 출처를 드립니다. 글 속 수치는 계산기와 같은 규칙표에서 가져오고, 바뀌면 글도 같이 바뀝니다. 지금 {all.length}편.</p>
  </div>
  {byCat.map((c) => (
    <section class="card" style="margin-bottom:12px">
      <h2 style="font-size:16px;margin:0">{c.name} <span class="sub">{c.desc}</span></h2>
      <ul class="gl">{c.items.map((e) => <li><a href={`/guide/${e.id}/`}><b>{e.data.title}</b><span class="sub">{e.data.description}</span><span class="sub d">{fmtDate(e.data.publishAt)}{e.data.updatedAt ? ` · 수정 ${fmtDate(e.data.updatedAt)}` : ''} · 기준 {e.data.asOf}</span></a></li>)}</ul>
    </section>
  ))}
  {all.length === 0 && <section class="card"><p class="sub2" style="margin:0">첫 글을 준비하고 있어요.</p></section>}
</Base>
<style>
  .gl { list-style: none; margin: 6px 0 0; padding: 0; }
  .gl li { border-bottom: 1px solid var(--soft); } .gl li:last-child { border-bottom: 0; }
  .gl a { display: flex; flex-direction: column; gap: 3px; padding: 12px 0; color: inherit; }
  .gl b { font-size: 15px; } .gl .d { font-size: 12px; }
  h2 .sub { font-weight: 500; margin-left: 6px; font-size: 13px; }
</style>
