---
import Base from '../../layouts/Base.astro';
---
<Base title="예산 계산기" description="보유 현금·연소득·기존 대출·가구 상황·지역을 넣으면 받을 수 있는 정책대출과 최대 매수 예산을 계산합니다. 디딤돌·신생아 특례·보금자리론·시중 주담대를 한 번에 비교.">
  <div id="app" class="calc">
    <div class="card"><p class="sub2" style="margin:0">계산기를 불러오는 중…</p></div>
    <noscript><div class="card" style="margin-top:12px"><p class="sub2" style="margin:0">계산기는 자바스크립트가 필요합니다.</p></div></noscript>
  </div>
</Base>

<script>
  import { mount } from '../../lib/calcui/app.ts';
  mount(document.getElementById('app')!);
</script>

<style is:global>
  .calc { display: flex; flex-direction: column; gap: 12px; }
  .calc .top { display: flex; justify-content: space-between; align-items: center; padding: 2px 4px; }
  .calc .back { border: 0; background: transparent; font-size: 26px; line-height: 1; color: var(--fg2); cursor: pointer; padding: 0 6px; }
  .calc .prog { height: 4px; background: var(--line); border-radius: 2px; overflow: hidden; }
  .calc .prog i { display: block; height: 100%; background: var(--blue); border-radius: 2px; transition: width .25s; }
  .calc .q { padding: 8px 4px 2px; }
  .calc .q h1 { margin: 10px 0 0; font-size: 24px; }
  .calc .q p { margin: 6px 0 0; }
  .calc .q .until { font-size: 20px; font-weight: 700; margin-left: 2px; letter-spacing: -0.02em; }
  .calc .card { margin: 0; }
  .calc .card.tight { padding: 14px 16px; }
  .calc .field + .field { margin-top: 16px; }
  .calc .input { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; padding: 6px 0 10px; border-bottom: 2px solid var(--line); }
  .calc .input:focus-within, .calc .input.focus { border-bottom-color: var(--blue); }
  .calc .input input { border: 0; outline: 0; background: transparent; width: 100%; min-width: 0; font: inherit; font-size: 28px; font-weight: 800; letter-spacing: -0.03em; color: var(--fg); font-variant-numeric: tabular-nums; padding: 0; }
  .calc .input span { font-size: 14px; color: var(--muted); font-weight: 500; white-space: nowrap; }
  .calc .chips { display: flex; gap: 7px; flex-wrap: wrap; margin-top: 10px; }
  .calc .chip { font-size: 12.5px; font-weight: 600; padding: 7px 12px; border-radius: 999px; background: var(--soft); color: var(--fg2); border: 0; cursor: pointer; }
  .calc .chip.on { background: var(--fg); color: #fff; }
  .calc .hint { margin-top: 8px; }
  .calc .row { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
  .calc .row .chips { margin-top: 0; }
  .calc .stepper { margin-top: 12px; }
  .calc .ctl { display: inline-flex; align-items: center; gap: 10px; }
  .calc .ctl button { width: 34px; height: 34px; border-radius: 10px; border: 0; background: var(--soft); color: var(--fg); font-size: 18px; cursor: pointer; }
  .calc .ctl b { min-width: 48px; text-align: center; font-variant-numeric: tabular-nums; }
  .calc select { width: 100%; font: inherit; font-size: 16px; padding: 12px 14px; border-radius: 12px; border: 1.5px solid var(--line); background: var(--card); color: var(--fg); margin-top: 6px; }
  .calc .btn[disabled] { background: #c9d2dc; cursor: not-allowed; }
  .calc .btn.ghost { flex: 1; }
  .calc .tr.full { width: 100%; text-align: left; background: transparent; border: 0; border-bottom: 1px solid var(--soft); cursor: pointer; padding: 13px 0; color: inherit; }
  .calc .tr.full:last-child { border-bottom: 0; }
  .calc .kv { display: grid; grid-template-columns: 1fr auto; gap: 8px 12px; font-size: 13.5px; font-variant-numeric: tabular-nums; }
  .calc .kv .k { color: var(--fg2); } .calc .kv .v { text-align: right; font-weight: 700; } .calc .kv .v.up { color: var(--green); }
  .calc .hr { height: 1px; background: var(--soft); margin: 14px 0; }
  .calc .bars { display: flex; flex-direction: column; gap: 12px; margin-top: 12px; }
  .calc .row.small { font-size: 13px; } .calc .row.small b { font-variant-numeric: tabular-nums; }
  .calc .bar { height: 8px; border-radius: 999px; background: var(--soft); overflow: hidden; margin-top: 6px; }
  .calc .bar i { display: block; height: 100%; background: var(--blue); border-radius: 999px; }
  .calc .bar i.bad { background: var(--red); }
  .calc .list { margin-top: 4px; }
  .calc .tr .v { font-weight: 700; font-size: 15px; font-variant-numeric: tabular-nums; white-space: nowrap; text-align: right; }
  .calc .tr .v small { display: block; font-weight: 500; color: var(--muted); font-size: 11px; }
  .calc .tr .v.muted { color: var(--muted); }
  .calc .tr.off .t { color: var(--fg2); }
  .calc .tr .d.note { margin-top: 2px; }
  .calc details.card summary { cursor: pointer; list-style: none; }
  .calc details.card summary::-webkit-details-marker { display: none; }
  .calc details.card summary::after { content: '▾'; float: right; color: var(--muted); }
  .calc details[open].card summary::after { content: '▴'; }
  .calc .ad-slot { min-height: 0; }
</style>
