---
// 쏙집 로고 락업: 아이콘(집 + 체크) + 워드마크. size: 'sm' | 'md'
interface Props { size?: 'sm' | 'md'; href?: string }
const { size = 'sm', href = '/' } = Astro.props;
const icon = size === 'md' ? 36 : 28;
const font = size === 'md' ? 24 : 19;
---
<a class="logo" href={href} aria-label="쏙집 홈" style={`--icon:${icon}px;--font:${font}px`}>
  <svg viewBox="0 0 64 64" aria-hidden="true">
    <rect width="64" height="64" rx="16" fill="#3182F6"/>
    <path d="M15 29.5 32 14.5l17 15V49a3.5 3.5 0 0 1-3.5 3.5h-27A3.5 3.5 0 0 1 15 49z" fill="none" stroke="#fff" stroke-width="5" stroke-linejoin="round"/>
    <path d="M24 35.5l5.5 5.5L41 29" fill="none" stroke="#fff" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <span class="wm"><b>쏙</b>집</span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 8px; }
  .logo svg { width: var(--icon); height: var(--icon); flex: 0 0 auto; }
  .wm { font-size: var(--font); font-weight: 800; letter-spacing: -0.045em; line-height: 1; color: var(--fg); }
  .wm b { color: var(--blue); font-weight: 800; }
</style>
