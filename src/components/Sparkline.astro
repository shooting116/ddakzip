---
// 월별 시세 추이 (SVG). series: [ym, median|null, n][]
interface Props { series: [string, number | null, number][]; height?: number; label?: string }
const { series, height = 72, label = '월별 중앙값' } = Astro.props;
const pts = series.map((s, i) => ({ i, ym: s[0], v: s[1], n: s[2] })).filter((p) => p.v != null) as { i: number; ym: string; v: number; n: number }[];
const W = 320, H = height, PAD = 6;
const vals = pts.map((p) => p.v);
const min = vals.length ? Math.min(...vals) : 0, max = vals.length ? Math.max(...vals) : 1;
const x = (i: number) => PAD + (i / Math.max(1, series.length - 1)) * (W - PAD * 2);
const y = (v: number) => (max === min ? H / 2 : PAD + (1 - (v - min) / (max - min)) * (H - PAD * 2));
const d = pts.map((p, k) => `${k ? 'L' : 'M'}${Math.round(x(p.i))} ${Math.round(y(p.v))}`).join(' ');
const last = pts[pts.length - 1];
const fmt = (v: number) => (v >= 10000 ? `${(v / 10000).toFixed(1).replace(/\.0$/, '')}억` : `${v.toLocaleString()}만`);
const first = series[0]?.[0], end = series[series.length - 1]?.[0];
---
<figure class="spark" aria-label={label}>
  {pts.length >= 2 ? (
    <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img">
      <path d={d} fill="none" stroke="var(--blue)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
      {last && <circle cx={Math.round(x(last.i))} cy={Math.round(y(last.v))} r="3.5" fill="var(--fg)" />}
    </svg>
  ) : <p class="sub" style="margin:0">월별 추이를 그릴 거래가 부족해요.</p>}
  <figcaption class="sub">
    <span>{first?.replace('-', '.')} → {end?.replace('-', '.')}</span>
    {pts.length >= 2 && <span>최저 {fmt(min)} · 최고 {fmt(max)}</span>}
  </figcaption>
</figure>
<style>
  .spark { margin: 8px 0 0; }
  .spark svg { width: 100%; height: 72px; display: block; }
  .spark figcaption { display: flex; justify-content: space-between; margin-top: 4px; }
</style>
