---
import '../styles/global.css';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** 홈처럼 상단에 로고를 크게 둘 때 */
  hero?: boolean;
}
const {
  title,
  description = '내 소득과 현금으로 어디까지 갈 수 있는지 계산하고, 예산에 딱 맞는 아파트를 찾아 비교합니다.',
  noindex = false,
  hero = false,
} = Astro.props;

const siteName = '딱집';
const fullTitle = title === siteName ? `${siteName} — 내 예산에 딱 맞는 집` : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://korea-rich.com').href;
const path = Astro.url.pathname;
const nav = [
  { href: '/calc/', label: '예산 계산기', short: '계산기', icon: 'calc' },
  { href: '/find/', label: '집 찾기', icon: 'map' },
  { href: '/area/', label: '지역', icon: 'grid' },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f2f4f6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <!-- Google AdSense 소유권 확인·광고 스크립트 (게시자 ID는 공개값). 심사 전까지는 광고가 표시되지 않는다. -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5901585061378578" crossorigin="anonymous"></script>
  </head>
  <body>
    <header class="top">
      <div class="wrap row">
        <Logo size={hero ? 'md' : 'sm'} />
        <nav aria-label="주요 메뉴">
          {nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>
              {n.icon === 'calc' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="5" y="2.5" width="14" height="19" rx="3" />
                  <rect x="8" y="5.5" width="8" height="4" rx="1" fill="currentColor" stroke="none" />
                  <circle cx="9" cy="13.5" r="1.1" fill="currentColor" stroke="none" />
                  <circle cx="12" cy="13.5" r="1.1" fill="currentColor" stroke="none" />
                  <circle cx="15" cy="13.5" r="1.1" fill="currentColor" stroke="none" />
                  <circle cx="9" cy="17.5" r="1.1" fill="currentColor" stroke="none" />
                  <circle cx="12" cy="17.5" r="1.1" fill="currentColor" stroke="none" />
                  <circle cx="15" cy="17.5" r="1.1" fill="currentColor" stroke="none" />
                </svg>
              )}
              {n.icon === 'map' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 21s-6-5.3-6-11a6 6 0 0 1 12 0c0 5.7-6 11-6 11z" /><circle cx="12" cy="10" r="2.3" fill="currentColor" stroke="none" />
                </svg>
              )}
              {n.icon === 'grid' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3.5" y="3.5" width="7" height="7" rx="1.5" /><rect x="13.5" y="3.5" width="7" height="7" rx="1.5" /><rect x="3.5" y="13.5" width="7" height="7" rx="1.5" /><rect x="13.5" y="13.5" width="7" height="7" rx="1.5" />
                </svg>
              )}
              <span class="full">{n.label}</span>{n.short && <span class="short">{n.short}</span>}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="wrap foot">
      <p class="src">
        딱집은 참고용 정보 서비스이며 대출 상담·부동산 중개를 하지 않습니다.
        실거래가 출처: 국토교통부 · 대출 규칙은 공개 자료 기준이며 실제 한도는 금융기관 심사에 따라 다릅니다.
      </p>
      <p class="src links">
        <a href="/calc/">예산 계산기</a> · <a href="/find/">집 찾기</a> · <a href="/area/">지역별</a> · <a href="/ref/">레퍼런스</a> · <a href="/compare/">비교</a> · <a href="/about/">소개</a> · <a href="/privacy/">개인정보처리방침</a> · <a href="/contact/">문의</a>
      </p>
    </footer>
  </body>
</html>

<style>
  .top { background: var(--bg); position: sticky; top: 0; z-index: 10; }
  .top .wrap { display: flex; justify-content: space-between; align-items: center; padding-block: 10px; }
  .top nav { display: flex; gap: 4px; }
  .top nav a { display: inline-flex; align-items: center; gap: 5px; font-size: 14px; font-weight: 600; color: var(--fg2); padding: 6px 8px; border-radius: 10px; white-space: nowrap; }
  .top nav .short { display: none; }
  @media (max-width: 420px) { .top nav a { font-size: 13px; padding: 6px 6px; gap: 4px; } .top nav a .short { display: inline; } .top nav a .short + .full, .top nav a:has(.short) .full { display: none; } }
  .top nav a:hover { background: var(--card); }
  .top nav a[aria-current="page"] { color: var(--blue); }
  .top nav svg { flex: none; }
  main.wrap { padding-top: 8px; }
  .foot { padding-top: 0; }
  .foot .links a { color: var(--fg2); font-weight: 600; }
</style>
