---
import '../styles/global.css';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** 홈처럼 상단에 로고를 크게 둘 때 */
  hero?: boolean;
}
const {
  title,
  description = '내 소득과 현금으로 어디까지 갈 수 있는지 계산하고, 예산에 딱 맞는 아파트를 찾아 비교합니다.',
  noindex = false,
  hero = false,
} = Astro.props;

const siteName = '딱집';
const fullTitle = title === siteName ? `${siteName} — 내 예산에 딱 맞는 집` : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://korea-rich.com').href;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f2f4f6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  </head>
  <body>
    <header class="top">
      <div class="wrap row">
        <Logo size={hero ? 'md' : 'sm'} />
        <nav aria-label="주요 메뉴">
          <a href="/calc/">계산기</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="wrap foot">
      <p class="src">
        딱집은 참고용 정보 서비스이며 대출 상담·부동산 중개를 하지 않습니다.
        실거래가 출처: 국토교통부 · 대출 규칙은 공개 자료 기준이며 실제 한도는 금융기관 심사에 따라 다릅니다.
      </p>
      <p class="src links">
        <a href="/about/">소개</a> · <a href="/privacy/">개인정보처리방침</a> · <a href="/contact/">문의</a>
      </p>
    </footer>
  </body>
</html>

<style>
  .top { background: var(--bg); position: sticky; top: 0; z-index: 10; }
  .top .wrap { display: flex; justify-content: space-between; align-items: center; padding-block: 10px; }
  .top nav a { font-size: 14px; font-weight: 600; color: var(--fg2); padding: 6px 10px; border-radius: 10px; }
  .top nav a:hover { background: var(--card); }
  main.wrap { padding-top: 8px; }
  .foot { padding-top: 0; }
  .foot .links a { color: var(--fg2); font-weight: 600; }
</style>
